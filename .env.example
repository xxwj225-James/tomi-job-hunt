# Tomi-Job-Hunt environment overrides (optional).
# Copy this file to `.env` to override ~/.tomi-job-hunt/config.json.
# NEVER commit your real `.env` file.

# Anthropic API key, used by both `claude-code` and `claude-api` providers.
# Alternative: ANTHROPIC_AUTH_TOKEN (short-lived token from "claude login").
ANTHROPIC_API_KEY=

# Default LLM provider: claude-code | claude-api | openai-compatible
TOMI_PROVIDER=claude-code

# Default model. Empty = SDK default (claude-sonnet-5).
# Cost-sensitive option: claude-haiku-4-5-20251001
TOMI_MODEL=

# Local API port (bound to 127.0.0.1 only)
TOMI_PORT=3000

# LLM concurrency limit (each claude-code call spawns a CLI subprocess)
TOMI_CONCURRENCY=2
