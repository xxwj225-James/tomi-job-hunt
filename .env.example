# TomiHunt environment overrides (optional).
# Copy this file to `.env` to override ~/.tomi-job-hunt/config.json.
# NEVER commit your real `.env` file.

# Default LLM provider:
#   claude-code | claude-api | deepseek | kimi | qwen | openai-compatible
TOMI_PROVIDER=claude-code

# Anthropic credentials (used by claude-code / claude-api).
# Alternative: ANTHROPIC_AUTH_TOKEN (short-lived token from "claude login").
ANTHROPIC_API_KEY=

# Generic API key for deepseek / kimi / qwen / openai-compatible.
# (DASHSCOPE_API_KEY from Alibaba Cloud console works for qwen.)
TOMI_API_KEY=

# OpenAI-compatible base URL — preset defaults, override if needed:
#   deepseek: https://api.deepseek.com/v1
#   kimi:     https://api.moonshot.cn/v1
#   qwen:     https://dashscope.aliyuncs.com/compatible-mode/v1
TOMI_BASE_URL=

# Default model per provider (preset defaults, override freely):
#   deepseek: deepseek-v4-flash (cost) / deepseek-v4-pro (reasoning)
#   kimi:     kimi-k2.6 / kimi-k2.7-code / kimi-k3
#   qwen:     qwen3.7-plus / qwen3.8-max (thinking-only)
TOMI_MODEL=

# Thinking mode (deepseek/qwen). Default off: faster, JSON-friendly.
# TOMI_THINKING=true

# Local API port (bound to 127.0.0.1 only)
TOMI_PORT=3000

# LLM concurrency limit (each claude-code call spawns a CLI subprocess)
TOMI_CONCURRENCY=2
