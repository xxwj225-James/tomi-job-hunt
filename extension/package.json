{
  "name": "@tomi/extension",
  "version": "0.1.0",
  "private": true,
  "description": "TomiHunt Chrome/Edge MV3 extension: JD extraction, AI panel, one-click fill",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build.mjs --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node scripts/build.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "jsdom": "^26.0.0",
