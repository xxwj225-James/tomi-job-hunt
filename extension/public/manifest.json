{
  "manifest_version": 3,
  "name": "TomiHunt — AI 求职雷达",
  "version": "0.1.0",
  "description": "本地 AI 求职助手：JD 提炼、匹配标签、高回复率打招呼语。所有数据留在本机。",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://www.liepin.com/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "https://api.deepseek.com/*",
    "https://api.moonshot.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/job_detail/*"],
      "js": ["content/zhipin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zhipin.com/web/geek/chat/*"],
      "js": ["content/zhipin-chat.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.zhipin.com/web/geek/job*"],
      "js": ["content/zhipin-list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.liepin.com/job/*"],
      "js": ["content/liepin.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TomiHunt"
  },
  "options_page": "options.html"
}
